# API base URL the app talks to. Unset → local dev defaults:
#   iOS simulator:    http://localhost:4000/api/v1
#   Android emulator: http://10.0.2.2:4000/api/v1  (the emulator's alias for your Mac)
# On a physical phone, use your Mac's LAN IP, e.g. http://192.168.1.20:4000/api/v1
EXPO_PUBLIC_API_URL=
